{
  "flutter": {
    "platforms": {
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "brewly-9e944",
          "configurations": {
            "android": "1:293355752303:android:b35d8f05fd5bdac95a769a",
            "web": "1:293355752303:web:ff4fb3aa7deb0ab35a769a"
          }
        }
      },
      "android": {
        "default": {
          "projectId": "brewly-9e944",
          "appId": "1:293355752303:android:b35d8f05fd5bdac95a769a",
          "fileOutput": "android/app/google-services.json"
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
