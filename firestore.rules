rules_version = '2';

// Bezpečnostní pravidla databáze Firestore pro Brewly.
// Hlídá je přímo Firebase, takže se nedají obejít – ani mimo naši aplikaci.
// Co tu není výslovně povolené, je zakázané.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Pomocné funkce ----------

    // Je uživatel přihlášený?
    function isSignedIn() {
      return request.auth != null;
    }

    // Role přihlášeného uživatele z jeho profilu (bez profilu = prázdný text).
    function myRole() {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(profilePath) ? get(profilePath).data.get('role', '') : '';
    }

    // Smí vyřizovat objednávky a požadavky? (obsluha i admin)
    function isStaff() {
      return isSignedIn() && myRole() in ['obsluha', 'admin'];
    }

    // Je to admin (vedoucí podniku)? Jen ten smí měnit menu.
    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    // Odpovídá kód stolu v novém dokumentu tajnému kódu stolu v databázi?
    // (Zákazník kód zná jen z QR kódu na stole, kde opravdu sedí.)
    function hasValidTableCode() {
      let tablePath = /databases/$(database)/documents/tables/$(string(request.resource.data.tableNumber));
      return exists(tablePath)
        && request.resource.data.tableCode == get(tablePath).data.code;
    }

    // Má podnik otevřeno? (Dokud nastavení neexistuje, je otevřeno.)
    function isVenueOpen() {
      let settingsPath = /databases/$(database)/documents/settings/venue;
      return !exists(settingsPath) || get(settingsPath).data.get('isOpen', true) == true;
    }

    // Kolikátý kus je zdarma (10 = každá 10. káva). (Volá se až po
    // isLoyaltyEnabled(), takže nastavení určitě existuje.)
    function loyaltyGoal() {
      return get(/databases/$(database)/documents/settings/venue).data.get('loyaltyGoal', 10);
    }

    // Má podnik zapnutou razítkovou kartu?
    function isLoyaltyEnabled() {
      let settingsPath = /databases/$(database)/documents/settings/venue;
      return exists(settingsPath) && get(settingsPath).data.get('loyaltyEnabled', false) == true;
    }

    // ---------- Stoly ----------
    // Tajné kódy stolů vidí obsluha i admin (tisknou QR kódy).
    // Nové kódy smí vygenerovat jen admin – vytištěné QR kódy na stolech
    // by jinak omylem přestaly platit.
    match /tables/{tableId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ---------- Menu ----------
    // Menu si může prohlédnout kdokoli (i nepřihlášený návštěvník).
    // Přidávat, upravovat a mazat produkty smí jen admin.
    match /products/{productId} {
      allow read: if true;

      // Má produkt všechny údaje ve správném tvaru?
      // categoryId musí odkazovat na existující kategorii – jako cizí klíč
      // v relační databázi. (existsAfter = po zápisu, aby šlo kategorii
      // a produkt založit v jednom hromadném zápisu.)
      function isValidProduct() {
        let product = request.resource.data;
        return product.keys().hasOnly(['name', 'price', 'categoryId', 'description', 'icon', 'available'])
          && product.name is string && product.name.size() > 0
          && product.name.size() <= 60
          && product.price is number && product.price > 0
          && product.price <= 10000
          && product.categoryId is string
          && existsAfter(/databases/$(database)/documents/categories/$(product.categoryId))
          && product.description is string
          && product.description.size() <= 300
          && product.get('icon', '') is string
          && product.get('icon', '').size() <= 20
          && product.get('available', true) is bool;
      }

      allow create, update: if isAdmin() && isValidProduct();
      allow delete: if isAdmin();
    }

    // ---------- Kategorie menu ----------
    // Vidí je každý, měnit je smí jen admin. Kategorie má jen název a pořadí.
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'order'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.order is int;
      // Že je kategorie prázdná (bez produktů), kontroluje aplikace –
      // pravidla neumí prohledat jinou kolekci.
      allow delete: if isAdmin();
    }

    // ---------- Nastavení podniku ----------
    // Název, barvu a další nastavení vidí každý (aplikace podle nich vypadá),
    // měnit je smí jen admin – a jen ve správném tvaru.
    match /settings/venue {
      allow read: if true;

      // Je text nejvýš "max" znaků dlouhý? (Když pole chybí, je to v pořádku.)
      function isShortText(field, max) {
        let value = request.resource.data.get(field, '');
        return value is string && value.size() <= max;
      }

      function isValidSettings() {
        let settings = request.resource.data;
        return settings.keys().hasOnly(['name', 'slogan', 'color', 'type', 'categoryOrder',
            'isOpen', 'announcement', 'address', 'openingHours', 'wifiName', 'wifiPassword',
            'loyaltyEnabled', 'loyaltyCategoryId', 'loyaltyGoal', 'reservationHours'])
          && settings.name is string && settings.name.size() > 0 && settings.name.size() <= 40
          && settings.slogan is string && settings.slogan.size() <= 80
          && settings.color in ['kava', 'bordo', 'terakota', 'olivova', 'lesni', 'namornicka', 'levandulova', 'grafitova']
          && settings.type in ['kavarna', 'cukrarna', 'bar', 'pivnice', 'restaurace']
          // categoryOrder = staré pořadí kategorií (dnes jsou kategorie
          // v kolekci categories) – už se neukládá, ve starých datech může být.
          && settings.get('categoryOrder', []) is list
          && settings.get('isOpen', true) is bool
          && isShortText('announcement', 120)
          && isShortText('address', 100)
          && isShortText('openingHours', 300)
          && isShortText('wifiName', 50)
          && isShortText('wifiPassword', 50)
          // Razítková karta: zapnutá, kategorie a počet razítek (3–20).
          && settings.get('loyaltyEnabled', false) is bool
          && isShortText('loyaltyCategoryId', 100)
          && settings.get('loyaltyGoal', 10) is int
          && settings.get('loyaltyGoal', 10) >= 3
          && settings.get('loyaltyGoal', 10) <= 20
          // Časy rezervací: 7 textů "08:00-20:00" (pondělí až neděle).
          && settings.get('reservationHours', ['', '', '', '', '', '', '']) is list
          && settings.get('reservationHours', ['', '', '', '', '', '', '']).size() == 7;
      }

      // Admin smí měnit vše (ve správném tvaru).
      allow create, update: if isAdmin() && isValidSettings();

      // Obsluha smí jen přepnout Otevřeno / Zavřeno – nic jiného.
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOpen'])
        && request.resource.data.isOpen is bool;
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['isOpen'])
        && request.resource.data.isOpen is bool;

      allow delete: if false;
    }

    // ---------- Uživatelé ----------
    match /users/{userId} {
      // Svůj profil vidí uživatel sám, profily všech vidí obsluha.
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());

      // Profil si uživatel může založit jen sám sobě a jen jako zákazník.
      // (Nikdo si tedy nemůže sám dát roli "obsluha".)
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
        && request.resource.data.role == 'zakaznik'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 100
        && request.resource.data.createdAt == request.time;

      // Svůj profil může upravit (jméno a avatar), ale roli si změnit nesmí.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.keys().hasOnly(
            ['name', 'email', 'role', 'createdAt', 'avatarIcon', 'avatarColor', 'themeMode',
             'favorites'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.get('avatarIcon', '') is string
        && request.resource.data.get('avatarIcon', '').size() <= 20
        && request.resource.data.get('avatarColor', '') is string
        && request.resource.data.get('avatarColor', '').size() <= 20
        && request.resource.data.get('themeMode', 'system') in ['system', 'light', 'dark']
        // Oblíbené produkty: seznam ID, nejvýš 100.
        && request.resource.data.get('favorites', []) is list
        && request.resource.data.get('favorites', []).size() <= 100;

      // Admin smí jinému účtu změnit roli zákazník ↔ obsluha – nic jiného.
      // Sobě ani jinému adminovi ne (adminy nastavuje vývojář v konzoli).
      allow update: if isAdmin()
        && request.auth.uid != userId
        && resource.data.get('role', '') != 'admin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['zakaznik', 'obsluha'];

      allow delete: if false;
    }

    // ---------- Čísla objednávek (náhrada AUTO_INCREMENT) ----------
    // Firestore neumí čísla 1, 2, 3… přidělovat sám (jako AUTO_INCREMENT
    // v MySQL), ID dokumentů jsou náhodné řetězce. Proto si v jednom
    // dokumentu pamatujeme poslední přidělené číslo a s každou objednávkou
    // ho v transakci zvýšíme o 1.
    // Čísla začínají každý den od 1. Den se bere z hodin serveru
    // (request.time), ne z telefonu – nikdo si tak čísla nevynuluje sám.
    match /orderNumbers/today {
      // Dnešní den jako číslo, např. 20261016 (v čase UTC).
      function today() {
        return request.time.year() * 10000 + request.time.month() * 100 + request.time.day();
      }

      allow read: if isSignedIn();

      // První objednávka vůbec: číslo 1, dnešní den.
      allow create: if isSignedIn()
        && request.resource.data.last == 1
        && request.resource.data.day == today();

      // Další objednávka: ve stejný den přesně o 1 víc,
      // v nový den znovu od 1.
      allow update: if isSignedIn()
        && request.resource.data.day == today()
        && (
          (resource.data.get('day', 0) == today()
            && request.resource.data.last == resource.data.last + 1)
          || (resource.data.get('day', 0) != today()
            && request.resource.data.last == 1)
        );

      allow delete: if false;
    }

    // ---------- Objednávky ----------
    match /orders/{orderId} {
      // Zákazník vidí jen své objednávky, obsluha vidí všechny.
      // (get('userId', '') = když pole chybí, použije se prázdný text.)
      allow read: if isSignedIn()
        && (resource.data.get('userId', '') == request.auth.uid || isStaff());

      // Číslo objednávky musí být to, které ve stejné transakci dostalo
      // počítadlo – a počítadlo se v ní opravdu muselo změnit.
      // (getAfter = stav po zápisu, get = stav před zápisem.)
      function hasNumberFromCounter() {
        let counterPath = /databases/$(database)/documents/orderNumbers/today;
        let after = getAfter(counterPath).data;
        return request.resource.data.number == after.last
          && (!exists(counterPath)
            || get(counterPath).data.last != after.last
            || get(counterPath).data.get('day', 0) != after.day);
      }

      // Objednávku může vytvořit jen přihlášený uživatel, a to jen sám za sebe,
      // ve stavu "prijata", ke stolu 1–10, se správným kódem stolu (z QR kódu),
      // s číslem z počítadla, s časem serveru a jen když má podnik otevřeno.
      // Objednávka smí mít jen tato pole – nic navíc.
      // Odměna z razítkové karty: buď v objednávce není vůbec, nebo má
      // ID produktu a kladnou slevu – a podnik musí mít kartu zapnutou.
      // Že má zákazník kartu opravdu plnou, pravidla nespočítají (musela by
      // projít všechny jeho objednávky) – ověří to obsluha v aplikaci.
      function isValidReward() {
        let order = request.resource.data;
        return (!('rewardProductId' in order) && !('rewardDiscount' in order)
            && !('rewardStamps' in order))
          || (order.rewardProductId is string
            && order.rewardProductId.size() > 0
            && order.rewardProductId.size() <= 100
            && order.rewardDiscount is number
            && order.rewardDiscount > 0
            && order.rewardDiscount <= 10000
            && isLoyaltyEnabled()
            // Odměna stojí přesně tolik razítek, kolik je teď nastaveno:
            // každá 10. káva zdarma = 9 razítek.
            && order.rewardStamps == loyaltyGoal() - 1);
      }

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['number', 'items', 'totalPrice',
            'tableNumber', 'tableCode', 'status', 'userId', 'customerName', 'createdAt',
            'rewardProductId', 'rewardDiscount', 'rewardStamps'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'prijata'
        && request.resource.data.tableNumber is int
        && request.resource.data.tableNumber >= 1
        && request.resource.data.tableNumber <= 10
        && request.resource.data.tableCode is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.totalPrice is number
        // Za 0 Kč jen tehdy, když je jediná položka odměna zdarma.
        && (request.resource.data.totalPrice > 0
          || (request.resource.data.totalPrice == 0 && 'rewardProductId' in request.resource.data))
        && request.resource.data.totalPrice <= 100000
        && isValidReward()
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.createdAt == request.time
        && hasNumberFromCounter()
        && hasValidTableCode()
        && isVenueOpen()
        // Obsluha a admin neobjednávají (zkreslilo by to statistiky
        // a mohli by si sami dokončovat objednávky a sbírat razítka).
        && !isStaff();

      // Stav objednávky může měnit jen obsluha – a nic jiného než stav.
      // Stav jde jen o jeden krok dopředu:
      // prijata → pripravujeSe → pripravena → dokoncena.
      function isNextStatus() {
        let next = {
          'prijata': 'pripravujeSe',
          'pripravujeSe': 'pripravena',
          'pripravena': 'dokoncena'
        };
        return resource.data.status in next
          && request.resource.data.status == next[resource.data.status];
      }

      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && isNextStatus();

      // Objednávky se nemažou (zůstávají jako historie).
      allow delete: if false;
    }

    // ---------- Docházka: kdo je právě v práci ----------
    // activeShifts/{uid} = zaměstnanec dal Příchod a ještě nedal Odchod.
    // Jeden dokument na člověka → Příchod nejde dát dvakrát.
    match /activeShifts/{userId} {
      // Svůj záznam vidí zaměstnanec, všechny vidí admin.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Příchod: jen obsluha, jen sama za sebe a s časem serveru
      // (čas příchodu si nikdo nemůže posunout).
      allow create: if isStaff()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['userId', 'userName', 'start'])
        && request.resource.data.userId == userId
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 100
        && request.resource.data.start == request.time;

      // Čas příchodu se nedá změnit.
      allow update: if false;

      // Odchod (zaměstnanec sám) nebo ukončení zapomenuté směny (admin).
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // ---------- Docházka: hotové směny ----------
    match /shifts/{shiftId} {
      // Své směny vidí zaměstnanec, všechny vidí admin.
      allow read: if isSignedIn()
        && (resource.data.get('userId', '') == request.auth.uid || isAdmin());

      function activeShiftPath(userId) {
        return /databases/$(database)/documents/activeShifts/$(userId);
      }

      // Hotová směna vzniká jen spolu s odchodem: příchod musí být přesně
      // ten zapsaný v activeShifts a ten záznam se ve stejném zápisu smaže
      // (existsAfter = stav po zápisu). Směny si tak nikdo nevymyslí.
      function isValidShift() {
        let shift = request.resource.data;
        return shift.keys().hasOnly(['userId', 'userName', 'start', 'end', 'edited'])
          && shift.userName is string
          && shift.userName.size() <= 100
          && exists(activeShiftPath(shift.userId))
          && shift.start == get(activeShiftPath(shift.userId)).data.start
          && !existsAfter(activeShiftPath(shift.userId));
      }

      // Odchod: obsluha sama za sebe, čas odchodu = čas serveru.
      function isOwnClockOut() {
        let shift = request.resource.data;
        return isStaff()
          && shift.userId == request.auth.uid
          && shift.end == request.time
          && shift.edited == false;
      }

      // Admin ukončí zapomenutou směnu: odchod zadá sám, ale musí být
      // po příchodu a ne v budoucnosti. Směna se označí jako upravená.
      function isAdminClose() {
        let shift = request.resource.data;
        return isAdmin()
          && shift.end is timestamp
          && shift.end > shift.start
          && shift.end <= request.time
          && shift.edited == true;
      }

      allow create: if isValidShift() && (isOwnClockOut() || isAdminClose());

      // Hotové směny se nemění ani nemažou (jsou podkladem pro výplatu).
      allow update, delete: if false;
    }

    // ---------- Rezervace ----------
    // Zákazník si zarezervuje stůl na den a čas (počet osob). Obsluha
    // rezervaci potvrdí (a může přidělit stůl), nebo odmítne.
    match /reservations/{reservationId} {
      // Zákazník vidí své rezervace, obsluha všechny.
      allow read: if isSignedIn()
        && (resource.data.get('userId', '') == request.auth.uid || isStaff());

      // Nová rezervace: zákazník sám za sebe, v budoucnu (nejvýš 31 dní
      // dopředu), 1–12 osob, krátká poznámka, stav „čeká“ a zatím bez stolu.
      function isValidNewReservation() {
        let reservation = request.resource.data;
        return isSignedIn()
          // Obsluha a admin nerezervují – jen rezervace vyřizují.
          && !isStaff()
          && reservation.keys().hasOnly(['userId', 'customerName', 'time', 'people',
                                         'note', 'status', 'tableNumber', 'createdAt'])
          && reservation.userId == request.auth.uid
          && reservation.customerName is string
          && reservation.customerName.size() > 0
          && reservation.customerName.size() <= 100
          && reservation.time is timestamp
          && reservation.time > request.time
          && reservation.time < request.time + duration.value(31, 'd')
          && reservation.people is int
          && reservation.people >= 1
          && reservation.people <= 12
          && reservation.note is string
          && reservation.note.size() <= 200
          && reservation.status == 'ceka'
          && reservation.tableNumber == 0
          && reservation.createdAt == request.time;
      }

      allow create: if isValidNewReservation();

      // Zákazník smí svou rezervaci jen zrušit (dokud čeká nebo je potvrzená).
      function isCustomerCancel() {
        return isSignedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && resource.data.status in ['ceka', 'potvrzena']
          && request.resource.data.status == 'zrusena';
      }

      // Obsluha čekající rezervaci potvrdí (se stolem 0–10, 0 = bez stolu)
      // nebo odmítne; potvrzenou může ještě odmítnout.
      function isStaffDecision() {
        let newData = request.resource.data;
        return isStaff()
          && newData.diff(resource.data).affectedKeys().hasOnly(['status', 'tableNumber'])
          && newData.tableNumber is int
          && newData.tableNumber >= 0
          && newData.tableNumber <= 10
          && (
            (resource.data.status == 'ceka' && newData.status in ['potvrzena', 'odmitnuta'])
            || (resource.data.status == 'potvrzena' && newData.status == 'odmitnuta')
          );
      }

      allow update: if isCustomerCancel() || isStaffDecision();

      // Rezervace se nemažou (zůstávají jako historie).
      allow delete: if false;
    }

    // ---------- Požadavky na obsluhu ----------
    // "Přivolat obsluhu" a "Chci zaplatit".
    match /requests/{requestId} {
      // Zákazník vidí své požadavky, obsluha všechny.
      allow read: if isSignedIn()
        && (resource.data.get('userId', '') == request.auth.uid || isStaff());

      // Je nový požadavek v pořádku? Posílá ho přihlášený zákazník sám za sebe,
      // povoleného typu, ke stolu 1–10 se správným kódem stolu a ve stavu "cekajici".
      function isValidNewRequest() {
        return isSignedIn()
          // Obsluha a admin požadavky neposílají – jen je vyřizují.
          && !isStaff()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.type in ['obsluha', 'platba']
          && request.resource.data.status == 'cekajici'
          && request.resource.data.tableNumber is int
          && request.resource.data.tableNumber >= 1
          && request.resource.data.tableNumber <= 10
          && hasValidTableCode()
          // Při zavřeno jde jen zaplatit, obsluhu přivolat ne.
          && (request.resource.data.type == 'platba' || isVenueOpen());
      }

      // Ochrana proti spamu: ID dokumentu musí být "uživatel_typ"
      // (např. abc123_platba), takže každý má pro každý typ jen jeden dokument.
      allow create: if isValidNewRequest()
        && requestId == request.auth.uid + '_' + request.resource.data.type;

      // Zákazník smí svůj požadavek znovu odeslat, jen když ho obsluha
      // už vyřídila. Dokud čeká, další stejný požadavek databáze odmítne.
      // Obsluha smí požadavek vyřídit (změnit stav na "vyrizeno").
      allow update: if (
          isValidNewRequest()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'vyrizeno'
          && request.resource.data.type == resource.data.type
        ) || (
          isStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'vyrizeno'
        );

      allow delete: if false;
    }
  }
}
